# Copy to .env.local for local runs. GitHub Actions sets these for the live build.

# The public address. The deploy workflow takes it from the Pages settings (the custom domain once set).
NEXT_PUBLIC_SITE_URL=https://www.escape-away.com

# true keeps a build out of search engines (for a preview copy). The live site leaves it false.
NEXT_PUBLIC_NOINDEX=false

# WhatsApp number that receives booking requests, digits only with the country code.
# Stand-in: the company number from the profile, until Escape Away confirms the request line.
NEXT_PUBLIC_WHATSAPP=201007009505

# WhatsApp number that receives owner leads, if it isn't the request line. Empty: the request line.
NEXT_PUBLIC_OWNER_WHATSAPP=

# Mapbox public token (pk.…) for the stays map, limited to the site's address in Mapbox.
# Leave empty to use MapLibre with OpenFreeMap's free tiles instead (no account needed).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Apps Script web app URL (ends in /exec) that writes booking requests and owner leads to the sheet.
# Setup: apps-script/README.md. Empty: the forms skip the sheet and WhatsApp carries everything.
NEXT_PUBLIC_FORM_ENDPOINT=

# The Google Business Profile's own link (its "Share" link), once Google has verified the Katameya office.
# Empty: the contact page's map link shows Katameya Dunes. Setup: docs/google-business-profile.md.
NEXT_PUBLIC_GBP_URL=

# export (GitHub Pages, default) or node (GoDaddy Node.js Hosting). npm run build:node sets node for you.
# BUILD_TARGET=export
