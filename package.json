{
  "name": "escape-away-website",
  "version": "0.1.0",
  "private": true,
  "description": "Escape Away website: the standalone demo in inquiry mode, built to take the booking system later.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "images": "node scripts/images.mjs",
    "predev": "node scripts/images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/images.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-windows-segments.mjs",
    "prebuild:node": "node scripts/images.mjs",
    "build:node": "next build",
    "start": "next start",
    "serve:out": "node scripts/serve-out.mjs",
    "check:export": "node scripts/check-export.mjs",
    "test:forms": "node scripts/test-forms-script.mjs",
    "test:arabic": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-arabic.mjs",
    "forms:sink": "node scripts/form-sink.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.78.0",
    "mapbox-gl": "3.34.2",
    "maplibre-gl": "6.16.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "supercluster": "9.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
